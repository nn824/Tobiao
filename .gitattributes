# 统一换行符：源码在仓库内一律 LF，避免 Windows/macOS 协作时整文件 diff
* text=auto eol=lf

*.go      text eol=lf
*.mod     text eol=lf
*.sum     text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.gitignore text eol=lf

*.bat     text eol=crlf
*.cmd     text eol=crlf

# 二进制
*.exe     binary
*.xls     binary
*.xlsx    binary
*.png     binary
*.jpg     binary
